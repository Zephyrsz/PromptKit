{
  "name": "PromptMaster",
  "version": "1.0.0",
  "description": "iOS app for Prompt management",
  "platform": "iOS 16.0+",
  "language": "Swift",
  "framework": "SwiftUI",
  "storage": {
    "engine": "SQLite3",
    "path": "Application Support/PromptKit/PromptKit.sqlite",
    "offline": true,
    "schema_version": 2,
    "bundled_import": "Resources/WebPrompts.sqlite",
    "import_source": "prompt_shortcut_tools",
    "tag_filter": "any_selected"
  },
  "features": [
    "Prompt notes and templates",
    "Quick access shortcuts",
    "Tag management",
    "Variable substitution",
    "Favorite templates",
    "Search and filter",
    "Offline persistence"
  ],
  "design": {
    "theme": "dark",
    "colors": {
      "surface1": "#101216",
      "surface2": "#14171C",
      "surface3": "#1B1F26",
      "surface4": "#252B34",
      "surface5": "#343D49",
      "accent": "#78C4ED",
      "accentMuted": "#99D5F3"
    },
    "typography": "iOS system semantic fonts with Dynamic Type; default design",
    "layout": {
      "page_inset": 20,
      "section_spacing": 24,
      "card_padding": 16,
      "card_radius": 14
    }
  },
  "architecture": {
    "pattern": "MVVM",
    "persistence": "System SQLite3",
    "state_management": "ObservableObject + @Published"
  }
}
